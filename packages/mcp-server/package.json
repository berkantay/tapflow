{
  "name": "@tapflowio/mcp-server",
  "version": "0.26.1",
  "description": "MCP server that lets LLM agents drive iOS simulators",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ios",
    "simulator",
    "ai-agent"
  ],
  "homepage": "https://github.com/jo-duchan/tapflow",
  "bugs": "https://github.com/jo-duchan/tapflow/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jo-duchan/tapflow.git",
    "directory": "packages/mcp-server"
  },
  "license": "MIT",
  "author": "tapflow contributors",
  "type": "module",
  "main": "dist/lib.js",
  "types": "dist/lib.d.ts",
  "bin": {
    "tapflow-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p src/__tests__/tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tapflowio/agent-core": "workspace:*",
    "@tapflowio/flow-runner": "workspace:*",
    "@tapflowio/ios-agent": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^5.0.0",
    "vitest": "^4.1.11"
  },
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "source": "./src/lib.ts",
      "tsx": "./src/lib.ts",
      "import": "./dist/lib.js",
      "default": "./dist/lib.js"
    },
    "./package.json": "./package.json"
  }
}
