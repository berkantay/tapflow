{
  "name": "tapflow",
  "version": "0.26.1",
  "description": "Drive iOS simulators from the command line: devices, flows, and an MCP server for agents",
  "keywords": [
    "ios",
    "simulator",
    "mcp",
    "automation",
    "qa"
  ],
  "homepage": "https://github.com/jo-duchan/tapflow",
  "bugs": "https://github.com/jo-duchan/tapflow/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/jo-duchan/tapflow.git"
  },
  "license": "MIT",
  "bin": {
    "tapflow": "./bin/tapflow.js"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "tsx": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p src/__tests__/tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@tapflowio/agent-core": "workspace:*",
    "@tapflowio/flow-runner": "workspace:*",
    "@tapflowio/ios-agent": "workspace:*",
    "@tapflowio/mcp-server": "workspace:*",
    "cac": "^6.7.14"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/ws": "^8.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0",
    "vitest": "^4.1.11"
  }
}
